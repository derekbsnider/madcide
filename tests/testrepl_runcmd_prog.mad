// testmadcide_repl.mad runs this program with %run (its argv shows how
// the arguments were split) and builds it with %build.
#include <stdio.h>

int twice(int x) { return 2 * x; }

int main(int argc, char **argv)
{
	printf("main argc=%d", argc);
	for ( int i = 1; i < argc; i++ )
		printf(" [%s]", argv[i]);
	printf("\n");
	return 0;
}
